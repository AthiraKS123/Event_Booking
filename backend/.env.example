PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/event_booking
JWT_SECRET=your_jwt_secret_access_key
JWT_REFRESH_SECRET=your_jwt_secret_refresh_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Razorpay Credentials (Get these from dashboard.razorpay.com in Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Real SMTP Email Credentials Configuration (e.g., Gmail, Resend, SendGrid, Brevo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="EventBook Platform" <no-reply@eventbook.com>
